# CivicPulse AI — Environment Variables
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to git

# ─── Supabase (Frontend Client Safe) ──────────────────────────────────────────
# Safe for browser bundle (VITE_ prefix). These use the public anonymous key.
# Get these from: https://app.supabase.com → Project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Edge Functions Server Secrets (Server-side ONLY) ─────────────────────────
# In Supabase, Edge Functions automatically receive SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY in their execution environment by default.
# Only the Gemini API key needs to be configured as a secret:
# Run: supabase secrets set GEMINI_API_KEY="your-gemini-api-key"
# NEVER put the service-role key or Gemini key in frontend code or git.
